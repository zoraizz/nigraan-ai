# Base URLs of the three Nigraan backend services.
# Vite only exposes variables prefixed with VITE_ to client code
# (see src/config/endpoints.js).

# Risk Flag (FastAPI, port 8000) — POST /predict-risk
VITE_RISK_API_URL=http://127.0.0.1:8000

# Damage Checker (FastAPI, port 8001) — POST /classify-damage and /classify-scene
# Local: in damage-checker, run `python -m uvicorn main:app --port 8001`.
# "Failed to fetch" on Damage Assessment means that process is not running.
# To use the deployed service instead, set the Render URL and restart Vite.
# A Render cold start can take 30–60 s.
VITE_DAMAGE_API_URL=http://127.0.0.1:8001
# VITE_DAMAGE_API_URL=https://nigraan-damage-checker.onrender.com

# Aid Priority (FastAPI, port 8002) — POST /rank-priority
VITE_PRIORITY_API_URL=http://127.0.0.1:8002

# For the deployed (Render) dashboard these are set as build-time environment
# variables pointing at the Render backend URLs instead of localhost
# (see README "Live Deployment").
