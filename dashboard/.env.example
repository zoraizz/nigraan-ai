# Base URLs of the three Nigraan backend services.
# Vite only exposes variables prefixed with VITE_ to client code
# (see src/config/endpoints.js).

# Risk Flag (FastAPI, port 8000) — POST /predict-risk
VITE_RISK_API_URL=http://127.0.0.1:8000

# Damage Checker (FastAPI, port 8001) — POST /classify-damage
VITE_DAMAGE_API_URL=http://127.0.0.1:8001

# Aid Priority (FastAPI, port 8002) — POST /rank-priority
VITE_PRIORITY_API_URL=http://127.0.0.1:8002
