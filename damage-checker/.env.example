# Damage Checker environment variables
# Copy this file to .env and adjust values as needed.

# Path to the trained model checkpoint (relative to damage-checker/ or absolute)
# v3 = combined xBD (tier1+tier3) + EBD Pakistan Flooding (July 2022) baseline
#      fine-tuned from v2; recovers "partial" class on Pakistan data (F1 0.00 -> 0.34)
# v2 = 5,000-tile xBD baseline (tier1 + tier3, class-weighted training) [superseded]
CHECKPOINT_PATH=checkpoints/xbd_ebd_v3.pth

# Comma-separated browser origins allowed to call this API (CORS).
# Default covers the local Vite dev server; the deployed dashboard's origin
# is configured in the hosting environment (see README "Live Deployment").
# CORS_ORIGINS=http://localhost:5173,https://nigraan-dashboard.onrender.com

# POST /classify-scene caps. Render free tier: 512 MB RAM, 0.5 vCPU.
# Pixel cap ~48 MiB of RGB; measured scene memory at this cap is ~128 MB.
# Tile cap targets ~30 s at a 6x slowdown from the measured 8-thread p95
# (111 tiles).
# The time budget stops a slower request and returns a partial scene.
# SCENE_MAX_PIXELS=16777216
# SCENE_MAX_TILES=111
# SCENE_TIME_BUDGET_SECONDS=40
