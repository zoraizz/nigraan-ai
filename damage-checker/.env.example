# Damage Checker environment variables
# Copy this file to .env and adjust values as needed.

# Path to the trained model checkpoint (relative to damage-checker/ or absolute)
# v3 = combined xBD (tier1+tier3) + EBD Pakistan Flooding (July 2022) baseline
#      fine-tuned from v2; recovers "partial" class on Pakistan data (F1 0.00 -> 0.34)
# v2 = 5,000-tile xBD baseline (tier1 + tier3, class-weighted training) [superseded]
CHECKPOINT_PATH=checkpoints/xbd_ebd_v3.pth

# Comma-separated browser origins allowed to call this API (CORS).
# Default covers the local Vite dev server; the deployed dashboard's origin
# is configured in the hosting environment (see README "Live Deployment").
# CORS_ORIGINS=http://localhost:5173,https://nigraan-dashboard.onrender.com

# POST /classify-scene caps. Render free tier: 512 MB RAM, 0.5 vCPU.
# Pixel cap ~48 MiB of RGB; measured scene memory at this cap is ~128 MB.
# Tile cap targets ~30 s at a 6x slowdown from the measured 8-thread p95
# (111 tiles).
# The time budget stops a slower request and returns a partial scene.
# SCENE_MAX_PIXELS=16777216
# SCENE_MAX_TILES=111
# SCENE_TIME_BUDGET_SECONDS=40

# Ground-photo vision providers (ordered, comma-separated: gemini,qwen).
# GEMINI_API_KEY=
# GEMINI_VL_MODEL=gemini-3.8-flash
# GROUND_VLM_PROVIDERS=gemini
# GROUND_VLM_TIMEOUT_SECONDS=20
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Workspace alternative: https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_VL_MODEL=qwen3-vl-plus

# POST /intake limits.
# GROUND_MAX_UPLOAD_BYTES=10485760
# GROUND_MIN_CONFIDENCE=0.6
# GROUND_DISTRICT_MAX_KM=60
# GROUND_DUPLICATE_MAX_HAMMING=8

# Ground reports and their JPEGs. Relative paths resolve from damage-checker/.
# Render's disk is ephemeral; set an absolute path only if a disk is mounted.
# GROUND_REPORTS_DIR=ground_reports

# Shared officer PIN for the review queue (X-Officer-Key header, or the
# officer_key query param for photos). 2026 is a DEMO value for evaluators;
# replace it in any real deployment. The code falls back to 2026 when unset.
OFFICER_REVIEW_KEY=2026
