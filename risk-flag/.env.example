# Gemini API key — get one free at https://aistudio.google.com/apikey
# Paste your key below (no quotes). Do not commit real keys.
GEMINI_API_KEY=your-key-here

# Used when set. Unset falls back to gemini-3.8-flash in code.
GEMINI_MODEL=gemini-3.8-flash

# Optional. Grok is called only after Gemini fails, and only when this is set.
# Leave it blank to use Gemini, then the rule-based scorer.
XAI_API_KEY=your-xai-key-here

# Used when set. Unset falls back to grok-4.3 (one non-reasoning call).
GROK_MODEL=grok-4.3

# Comma-separated browser origins allowed to call this API (CORS).
# Default covers the local Vite dev server; the deployed dashboard's origin
# is configured in the hosting environment (see README "Live Deployment").
# CORS_ORIGINS=http://localhost:5173,https://nigraan-dashboard.onrender.com
