# Aid Priority environment variables
# Copy this file to .env and adjust values as needed.

# Scoring weights for:
#   priority = (risk_weight * risk_score + damage_weight * damage_score)
#              / (risk_weight + damage_weight)
#
# Defaults weight observed damage (0.6) above forecast risk (0.4) because
# post-event triage should be driven primarily by what has already happened.
# The formula normalizes by the weight sum, so scores always stay in [0, 1].
PRIORITY_RISK_WEIGHT=0.4
PRIORITY_DAMAGE_WEIGHT=0.6

# Each optional signal in scoring.OPTIONAL_SIGNALS reads its weight from its
# own weight_env; unset uses the signal's default_weight.
#
# River Flood Tracker: hours until the peak reaches the district.
# Score is 1.0 up to 12 h, then falls linearly to 0 at 120 h.
# Once any district sends an ETA, a district without one scores 0
# (missing_policy "zero"). Requests that omit the field are unchanged.
PRIORITY_FLOOD_WEIGHT=0.3

# Ground Photo Intake: share of unique non-rejected reports.
# (0.5*partial + 1.0*destroyed) / unique reports. missing_policy "skip".
# Unset uses the signal default_weight 0.2.
# PRIORITY_GROUND_WEIGHT=0.2

# Districts whose damage assessment rests on fewer tiles than this get a
# low_coverage_warning in the /rank-priority response. Transparency signal
# for response teams only -- never affects the priority score or ranking.
LOW_COVERAGE_TILE_THRESHOLD=5

# Comma-separated browser origins allowed to call this API (CORS).
# Default covers the local Vite dev server; the deployed dashboard's origin
# is configured in the hosting environment (see README "Live Deployment").
# CORS_ORIGINS=http://localhost:5173,https://nigraan-dashboard.onrender.com
