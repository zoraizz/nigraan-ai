# River Flood Tracker environment variables
# Copy this file to .env and fill in values. Never commit .env or a key;
# on Render set these in the service's environment settings.

# Comma-separated browser origins allowed to call this API (CORS).
# Empty or unset: http://localhost:5173 (local Vite dev server).
CORS_ORIGINS=

# Alert drafts: gemini | qwen | template. Empty or unset: gemini.
# /health reports the provider and whether its key is set, never the key.
ALERT_LLM_PROVIDER=

# Gemini (ALERT_LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# Qwen via Alibaba Cloud DashScope (ALERT_LLM_PROVIDER=qwen)
DASHSCOPE_API_KEY=
QWEN_MODEL=
